---
layout: page.njk
---
{% block head %}
<link rel="stylesheet" href="{{ '/static/css/swiper-bundle.min.css' | url }}"/>
{% endblock %}

{% if heroImage %}
<div class="home-hero-wrapper">
  <div class="home-slideshow-fs">
    <img src="{{ heroImage }}" alt="{{ title }}" class="img-cover">
  </div>
  <section class="home-hero-overlay">
    <h1 class="home-title">{{ title }}</h1>
    {% if description %}<p class="home-intro">{{ description }}</p>{% endif %}
    <div class="post-meta" style="margin-top: 1rem;">
      {% if date %}<time datetime="{{ date | isoDate }}" style="color: rgba(255, 255, 255, 0.8);">{{ date | readableDate }}</time>{% endif %}
      {% if tags and tags.length %}
        {% for tag in tags %}<span class="tag" style="background: rgba(255, 255, 255, 0.15); border-color: transparent; color: #fff;">{{ tag }}</span>{% endfor %}
      {% endif %}
    </div>
  </section>
</div>
{% endif %}

<article class="post">
  <div class="post-body">
    {% if not heroImage %}
    <header class="post-header">
      <h1>{{ title }}</h1>
      <div class="post-meta">
        {% if date %}<time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% endif %}
        {% if tags and tags.length %}
          {% for tag in tags %}<span class="tag">{{ tag }}</span>{% endfor %}
        {% endif %}
      </div>
    </header>
    {% endif %}
    <div class="post-content">{{ content | safe }}</div>
    {% if 'gallery-start' in content %}<script src="{{ '/static/js/swiper-bundle.min.js' | url }}"></script>{% endif %}
  </div>
</article>

{% set related = collections.posts | relatedPosts(page.url, tags) %}
{% if related and related.length %}
<div class="gallery-related">
  <p class="section-label">Related Posts</p>
  <div class="story-list">
    {% for post in related %}
    <a href="{{ post.url | url }}" class="story-card">
      <div class="story-card-img">
        {% if post.data.coverImage %}
        <img src="{{ post.data.coverImage }}" alt="{{ post.data.title }}" loading="lazy">
        {% endif %}
      </div>
      <div class="story-card-body">
        <div class="post-card-meta">
          {% if post.data.tags %}
          <div class="post-card-tags">
            {% for tag in post.data.tags | limit(2) %}<span class="tag">{{ tag }}</span>{% endfor %}
          </div>
          {% endif %}
        </div>
        <div class="story-card-title">{{ post.data.title }}</div>
        {% if post.data.excerpt %}<div class="story-card-desc">{{ post.data.excerpt }}</div>{% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
</div>
{% endif %}
