<script>  async function updateCounter() {
    try {
      const response = await fetch('https://niallxd--110a558a4a6d11f191a4ee650bb23af1.web.val.run');
      const rows = await response.json();
      const count = rows.filter(([url, title, ts, ns]) => !url.includes('localhost') && !url.includes('127.0.0.1') && ns).length;
      document.getElementById('visitor-count').innerText = count.toLocaleString();
    } catch (err) {
      document.getElementById('visitor-count').innerText = '...';
    }
  }
  updateCounter();
  </script>

<script src="{{ '/static/js/swiper-bundle.min.js' | url }}"></script>
<script src="{{ '/static/js/leaflet.js' | url }}"></script>
<script src="{{ '/static/js/leaflet.markercluster.js' | url }}"></script>
<script src="{{ '/static/js/goodreads.js' | url }}?v=5"></script>
<script>
  new Swiper('.home-swiper', {
    loop: true,
    autoplay: { delay: 5000, pauseOnMouseEnter: true, disableOnInteraction: false },
    speed: 800,
    pagination: { el: '.swiper-pagination', clickable: true },
    navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
  });

  {% if mapPins and mapPins.length %}
  const homePins = {{ mapPins | dump | safe }}.filter(p => p.src);
  if (homePins.length) {
    const worldBounds = [[-85, -180], [85, 180]];
    const homeMap = L.map('home-photo-map', {
      scrollWheelZoom: false,
      touchZoom: true,
      minZoom: 2,
      maxBounds: worldBounds,
      maxBoundsViscosity: 1.0
    }).setView([50, -15], 1);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
      maxZoom: 19
    }).addTo(homeMap);
    const homeCluster = L.markerClusterGroup({ maxClusterRadius: 60, zoomToBoundsOnClick: false, spiderfyOnMaxZoom: false });
    homePins.forEach(pin => {
      const icon = L.divIcon({
        className: 'photo-marker',
        html: `<div class="photo-marker-inner"><img src="${pin.src}" alt="${pin.title}"></div>`,
        iconSize: [56, 56],
        iconAnchor: [28, 28]
      });
      L.marker([pin.lat, pin.lng], { icon }).addTo(homeCluster);
    });
    homeMap.addLayer(homeCluster);

    // The homepage widget is just a teaser — any click sends visitors to the full map
    const goToFullMap = () => { window.location.href = '{{ "/photo-map/" | url }}'; };
    homeMap.on('click', goToFullMap);
    homeCluster.on('click', goToFullMap);
    homeMap.getContainer().style.cursor = 'pointer';
  }
  {% endif %}

  // 100 Particles - A gentle, glowing swarm
  const canvas = document.getElementById('heart-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const particles = [];
    const colors = ['#ffb703', '#fb8500', '#ff4d00', '#FF860D'];

    // Create 100 particles
    for(let i=0; i<100; i++) {
      particles.push({
        x: 200,
        y: 200,
        vx: (Math.random() - 0.5) * (Math.random() * 4),
        vy: (Math.random() - 0.5) * (Math.random() * 4),
        size: Math.random() * 2 + 1,
        color: colors[Math.floor(Math.random() * colors.length)],
        life: Math.random() * 150 + 50,
        maxLife: 200
      });
    }

    function drawParticles() {
      ctx.clearRect(0, 0, 400, 400);
      for(let i=0; i<particles.length; i++) {
        let p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life--;
        
        if(p.life <= 0) {
          p.x = 200;
          p.y = 200;
          p.vx = (Math.random() - 0.5) * (Math.random() * 4);
          p.vy = (Math.random() - 0.5) * (Math.random() * 4);
          p.life = Math.random() * 150 + 50;
          p.maxLife = p.life;
        }
        
        ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
        // Add a slight glow per particle
        ctx.shadowBlur = 10;
        ctx.shadowColor = p.color;
      }
      ctx.shadowBlur = 0; // reset for next frame
      requestAnimationFrame(drawParticles);
    }
    drawParticles();
  }

  // Smooth Details Animation
  document.querySelector('.welcome-expansion summary').addEventListener('click', function(e) {
    const details = this.parentElement;
    const wrapper = details.querySelector('.expansion-wrapper');
    
    if (details.open) {
      e.preventDefault(); // Prevent instant close
      details.classList.add('closing');
      setTimeout(() => {
        details.open = false;
        details.classList.remove('closing');
      }, 400); // Matches CSS transition time
    }
  });
</script>
